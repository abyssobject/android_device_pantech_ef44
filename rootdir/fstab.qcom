# VEGA S5 (ef44) fstab for LineageOS 19.1
#<src>                                                 <mnt_point>  <type>  <mnt_flags and options>                                              <fs_mgr_flags>
/dev/block/platform/msm_sdcc.1/by-name/boot            /boot        emmc    defaults                                                             recoveryonly
/dev/block/platform/msm_sdcc.1/by-name/recovery        /recovery    emmc    defaults                                                             recoveryonly
/dev/block/platform/msm_sdcc.1/by-name/system          /system      ext4    ro,barrier=1                                                         wait,first_stage_mount
/dev/block/platform/msm_sdcc.1/by-name/persist         /persist     ext4    nosuid,nodev,barrier=1,data=ordered,nodelalloc                       wait
/dev/block/platform/msm_sdcc.1/by-name/userdata        /data        ext4    nosuid,nodev,noatime,noauto_da_alloc,barrier=1                       latemount,wait,check,formattable,length=-16384
/dev/block/platform/msm_sdcc.1/by-name/cache           /cache       ext4    nosuid,nodev,noatime,noauto_da_alloc,barrier=1                       wait,check,formattable
/dev/block/platform/msm_sdcc.1/by-name/modem           /firmware    vfat    ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0  wait
/dev/block/platform/msm_sdcc.1/by-name/misc            /misc        emmc    defaults                                                             defaults
/devices/platform/msm_sdcc.3/mmc_host/mmc1*            auto         auto    defaults                                                             voldmanaged=sdcard1:auto
/devices/platform/msm_hsusb_host/usb*                  auto         auto    defaults                                                             voldmanaged=usbdisk:auto
/dev/block/zram0                                       none         swap    defaults                                                             zramsize=402653184,max_comp_streams=2
