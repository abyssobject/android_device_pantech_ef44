# VEGA S5 (ef44), LineageOS 19.1
# Based on Sony blue-common (MSM8960, LineageOS 18.1) and the ef44 cm-14.1 port

import /vendor/etc/init/hw/init.ef44.usb.rc
import /vendor/etc/init/hw/init.ef44.debug.rc

on early-init
    # Process groups: Android 12 keeps uid_*/pid_* groups in the cgroup2
    # hierarchy at /sys/fs/cgroup, which this 3.4 kernel cannot mount. A v1
    # named hierarchy without controllers gives the same mkdir/cgroup.procs
    # interface, so init and lmkd can create, track and kill process groups
    # (without it every service start logged an error and "stop" could not
    # kill a service, e.g. rild hung in "stopping").
    mount cgroup none /sys/fs/cgroup nosuid nodev noexec none,name=procgroup
    chown system system /sys/fs/cgroup
    chmod 0755 /sys/fs/cgroup
    mount debugfs /sys/kernel/debug /sys/kernel/debug
    mkdir /firmware 0771 system system
    symlink /data/tombstones /tombstones

on init
    symlink /dev/socket /tmp

on fs
    wait /dev/block/platform/msm_sdcc.1
    symlink /dev/block/platform/msm_sdcc.1 /dev/block/bootdevice
    mount_all /vendor/etc/fstab.qcom --early
    # Start HW service manager early
    start hwservicemanager

on late-fs
    # Start services for bootanim
    start surfaceflinger
    start bootanim
    start vendor.gralloc-2-0
    start vendor.hwcomposer-2-1
    mount_all /vendor/etc/fstab.qcom --late

on early-boot
    # set RLIMIT_MEMLOCK to 64MB
    setrlimit 8 67108864 67108864

on post-fs
    chmod 0222 /sys/kernel/debug/tracing/trace_marker

on post-fs-data
    mkdir /data/tombstones 0771 system system
    mkdir /tombstones/modem 0771 system system
    mkdir /tombstones/lpass 0771 system system
    mkdir /tombstones/wcnss 0771 system system
    mkdir /tombstones/dsps 0771 system system
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/sockets 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi
    mkdir /data/misc/audio 0770 audio audio
    mkdir /data/audio 0770 media audio
    mkdir /data/system 0775 system system
    mkdir /data/system/sensors 0775 system system
    mkdir /data/misc/sensors 0775 system system
    mkdir /data/misc/location 0770 gps gps
    mkdir /data/camera 0771 media camera
    setprop vold.post_fs_data_done 1
    # The camera daemon must be up before cameraserver (class main) probes the
    # cameras: that probe decides once whether camera 0 has a flash (torch)
    start qcamerasvr
    start sensors

on boot
    # (No per-cgroup RT budgets here: the kernel is built without
    # RT_GROUP_SCHED since #68. With it, the cpu cgroups had to be given
    # cpu.rt_runtime_us for SCHED_FIFO at all, and the foreground group's 10%
    # throttled the Bluetooth A2DP encoder: Bluetooth audio stuttered.)

    # zram swap: ~830 MB of usable RAM is not enough for Android 12 without it
    write /proc/sys/vm/swappiness 100
    write /proc/sys/vm/page-cluster 0
    swapon_all /vendor/etc/fstab.qcom

    # Graphics
    chown system graphics /sys/class/graphics/fb1/hpd
    chmod 0664 /sys/class/graphics/fb1/hpd
    chown system graphics /sys/class/graphics/fb0/msm_fb_fps_level
    chmod 644 /sys/class/graphics/fb0/msm_fb_fps_level

    # RTC, vibrator, backlight, LEDs
    chmod 660 /dev/rtc0
    chown system system /dev/rtc0
    chown system system /sys/class/timed_output/vibrator/enable
    chown system system /sys/class/leds/lcd-backlight/brightness
    chown system system /sys/class/leds/red/brightness
    chown system system /sys/class/leds/green/brightness
    chown system system /sys/class/leds/blue/brightness
    chown system system /sys/class/leds/red/blink
    chown system system /sys/class/leds/green/blink
    chown system system /sys/class/leds/blue/blink

    # Bluetooth (BCM4334 on ttyHS0)
    chown bluetooth net_bt /sys/class/rfkill/rfkill0/type
    chown bluetooth net_bt /sys/class/rfkill/rfkill0/state
    chmod 0660 /sys/class/rfkill/rfkill0/state
    chown bluetooth net_bt /proc/bluetooth/sleep/proto
    chmod 0660 /proc/bluetooth/sleep/proto
    chown bluetooth net_bt /dev/ttyHS0
    chmod 0660 /dev/ttyHS0
    chown bluetooth net_bt /sys/devices/platform/msm_serial_hs.0/clock
    chmod 0660 /sys/devices/platform/msm_serial_hs.0/clock

    # QMUX sockets
    mkdir /dev/socket/qmux_radio 0770 radio radio
    chmod 2770 /dev/socket/qmux_radio
    mkdir /dev/socket/qmux_audio 0770 media audio
    chmod 2770 /dev/socket/qmux_audio
    mkdir /dev/socket/qmux_bluetooth 0770 bluetooth bluetooth
    chmod 2770 /dev/socket/qmux_bluetooth
    mkdir /dev/socket/qmux_gps 0770 gps gps
    chmod 2770 /dev/socket/qmux_gps

    # Wi-Fi: there is no vendor Wi-Fi HAL (the 2013 bcmdhd lacks the nl80211
    # vendor commands it needs), so the framework only uses wificond and
    # wpa_supplicant; set the station firmware and nvram here instead
    write /sys/module/bcmdhd/parameters/firmware_path /system/vendor/firmware/fw_bcmdhd.bin
    write /sys/module/bcmdhd/parameters/nvram_path /system/etc/nvram_4334.txt
    chown wifi wifi /sys/module/bcmdhd/parameters/firmware_path
    chmod 0660 /sys/module/bcmdhd/parameters/firmware_path
    setprop wifi.interface wlan0

    # CPU: both Krait cores, interactive governor
    write /sys/module/msm_thermal/core_control/enabled 0
    write /sys/devices/system/cpu/cpu1/online 1
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor interactive
    write /sys/devices/system/cpu/cpu1/cpufreq/scaling_governor interactive
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_min_freq 384000
    write /sys/devices/system/cpu/cpu1/cpufreq/scaling_min_freq 384000
    write /sys/block/mmcblk0/queue/add_random 0
    write /proc/sys/vm/page-cluster 0

# Modem and RIL support
service rmt_storage /system/bin/rmt_storage /dev/block/platform/msm_sdcc.1/by-name/modemst1 /dev/block/platform/msm_sdcc.1/by-name/modemst2 /dev/block/platform/msm_sdcc.1/by-name/fsg
    class core
    user root
    group system wakelock
    setenv LD_PRELOAD /system/lib/libshim_rmt.so

service qmuxd /system/bin/qmuxd
    class main
    user radio
    group radio audio bluetooth gps wakelock

service netmgrd /system/bin/netmgrd
    class main
    user root
    group radio system wakelock

service ef44-modemchk /system/bin/sh /system/vendor/bin/init.ef44.modem.sh
    class late_start
    user root
    oneshot
    disabled

on property:sys.boot_completed=1
    start ef44-modemchk

# Bluetooth address from /persist/.bt_nv.bin (see ef44-bdaddr.sh)
service ef44-bdaddr /system/bin/sh /system/vendor/bin/ef44-bdaddr.sh
    class core
    user root
    oneshot
    disabled

on post-fs-data
    start ef44-bdaddr
    mkdir /data/vendor/ef44 0770 root system
    # fonts added in Settings > Display > Font (the chosen one is read by every
    # app: under /data/fonts, font_data_file)
    mkdir /data/fonts/ef44 0771 system system
    exec - root root -- /system/bin/sh /system/vendor/bin/ef44-rtc.sh restore

# Wall clock offset to the read-only RTC (see ef44-rtc.sh)
service ef44-rtc-save /system/bin/sh /system/vendor/bin/ef44-rtc.sh save
    class late_start
    user root

on shutdown
    exec - root root -- /system/bin/sh /system/vendor/bin/ef44-rtc.sh saveonce

# Sensors (Qualcomm DSPS sensor daemon feeding the KK HAL). Started from
# post-fs-data so it is up before the sensors HAL (class hal) asks for the
# sensor list. The blob is patched (poll nfds 1 -> 2): it read the second
# pollfd's revents without polling it, and the stack garbage there made it
# exit right after start on Android 12.
service sensors /system/bin/sensors.qcom
    class late_start
    user root
    group root radio system
    disabled

# Camera daemon for the JB camera blobs. liboemcamera relies on large
# allocations coming back zeroed, as old dlmalloc's mmap did; scudo does not
# guarantee that, so a stale callback pointer crashed it on the first request.
service qcamerasvr /system/bin/mm-qcamera-daemon
    class late_start
    user camera
    group camera system inet input graphics
    setenv SCUDO_OPTIONS zero_contents=1
    # Clears the stale revents the pp thread's poll loop reads (libshims/mmcamera_daemon.c)
    setenv LD_PRELOAD /system/lib/libshim_mmcamera.so

# Bluetooth: BCM4334 patchram + hciattach
service hciattach /system/bin/sh /system/vendor/bin/init.qcom.bt.sh
    class late_start
    user bluetooth
    group bluetooth net_bt_admin system
    disabled
    oneshot

on property:vendor.bluetooth.hciattach=true
    start hciattach

on property:vendor.bluetooth.hciattach=false
    setprop vendor.bluetooth.status off
