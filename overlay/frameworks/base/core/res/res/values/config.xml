<!-- These resources are around just to allow their values to be customized
     for different hardware and product builds. -->
<resources>

    <!-- Hardware 'face' keys present on the device, stored as a bit field.
         This integer should equal the sum of the corresponding value for each
         of the following keys present:
             1 - Home
             2 - Back
             4 - Menu
             8 - Assistant (search)
            16 - App switch
            32 - Camera
            64 - Volume rocker
         For example, a device with Home, Back and Menu keys would set this
         config to 7. -->
    <integer name="config_deviceHardwareKeys">64</integer>

    <!-- Backlight to nits mapping for the Sony 4.8" WM panel (approximate).
         Without it Android 12's LocalDisplayAdapter asked for nits on every
         brightness change and logged a WTF each time (~500 per boot). -->
    <integer-array name="config_screenBrightnessBacklight">
        <item>1</item>
        <item>255</item>
    </integer-array>
    <array name="config_screenBrightnessNits">
        <item>2.0</item>
        <item>450.0</item>
    </array>

    <!-- The WCD9310 MBHC reports the wired headset through the ASoC
         "Headset Jack" input device (SW_HEADPHONE_INSERT and
         SW_MICROPHONE_INSERT); there is no h2w switch class. -->
    <bool name="config_useDevInputEventForAudioJack">true</bool>

    <!-- VEGA Messages (com.pantech.app.mms, launcher/Android.mk) replaces
         LineageOS Messaging: the default SMS app (role android.app.role.SMS)
         of a new install -->
    <string name="config_defaultSms" translatable="false">com.pantech.app.mms</string>

</resources>
